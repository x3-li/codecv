    {
      "id": "L63moB35D0R6Z1mO2OGVt",
      "type": "text",
      "x": 95,
      "y": 890,
      "width": 1070,
      "height": 80,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1474936931,
      "version": 1,
      "versionNonce": 1982095275,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781842134887,
      "link": null,
      "locked": false,
      "text": "構成説明：DGX Spark #1 は Web UI、LiteLLM ロードバランサー、vLLM 推論を兼務し、OpenWebUI、LiteLLM、各DB、vLLMを Docker コンテナとして稼働する。DGX Spark #2 は vLLM コンテナのみを稼働し、LiteLLM が DGX Spark #1／#2 の vLLM に対してロードバランシングを行う。さらに DGX Spark #1 の crontab により、毎日深夜に会話履歴を抽出し、Windows FTP サーバーへ転送する。",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "構成説明：DGX Spark #1 は Web UI、LiteLLM ロードバランサー、vLLM 推論を兼務し、OpenWebUI、LiteLLM、各DB、vLLMを Docker コンテナとして稼働する。DGX Spark #2 は vLLM コンテナのみを稼働し、LiteLLM が DGX Spark #1／#2 の vLLM に対してロードバランシングを行う。さらに DGX Spark #1 の crontab により、毎日深夜に会話履歴を抽出し、Windows FTP サーバーへ転送する。",
      "autoResize": false,
      "lineHeight": 1.25
    },
